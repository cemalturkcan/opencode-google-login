{
  "name": "opencode-google-login",
  "version": "1.4.0",
  "description": "OpenCode plugin that adds a Google (custom) provider backed by Antigravity and Gemini CLI auth.",
  "keywords": [
    "gemini",
    "google",
    "login",
    "oauth",
    "opencode",
    "plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cemalturkcan/opencode-google-login.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --format esm && tsc --emitDeclarationOnly",
    "clean": "rm -rf dist",
    "prepare": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt --write .",
    "format": "oxfmt --write .",
    "test": "bun test"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.3.3"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "bun-types": "^1.3.6",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "semantic-release": "^25.0.3",
    "typescript": "^5.7.3"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "releaseRules": [
            {
              "type": "refactor",
              "release": "patch"
            },
            {
              "type": "perf",
              "release": "patch"
            },
            {
              "type": "test",
              "release": "patch"
            },
            {
              "type": "chore",
              "scope": "deps",
              "release": "patch"
            }
          ]
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  }
}
